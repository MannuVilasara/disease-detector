FROM python:3.12-slim AS builder

# Install build-time packages
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy uv tool (used for dependency management)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Use a temporary cache directory inside the builder and make it writable
ENV UV_CACHE_DIR=/tmp/uv-cache
RUN mkdir -p /tmp/uv-cache && chmod 0777 /tmp/uv-cache

# Copy dependency files and install into .venv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --cache-dir /tmp/uv-cache

# Copy application source
COPY . .

### Final stage: runtime image
FROM python:3.12-slim

# Minimal runtime deps
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy uv (runtime) so run.sh can call `uv run` if needed
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Create a non-root user with a home directory
RUN groupadd -r appuser && useradd -r -g appuser -m -d /home/appuser appuser

# Configure environment so uv uses the appuser cache paths
ENV HOME=/home/appuser
ENV XDG_CACHE_HOME=/home/appuser/.cache
ENV UV_CACHE_DIR=/home/appuser/.cache/uv
ENV PATH=/app/.venv/bin:$PATH

# Ensure cache directories exist and are writable by appuser
RUN mkdir -p /home/appuser/.cache/uv \
    && chown -R appuser:appuser /home/appuser \
    && chmod -R 0777 /home/appuser/.cache/uv

WORKDIR /app

# Copy the virtual environment created in the builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY --from=builder /app /app

# Ensure startup script is executable and app directory owned by appuser
RUN chmod +x ./run.sh && chown -R appuser:appuser /app

# Run as non-root user
USER appuser

# Expose the production port (Gunicorn default in run.sh is 8000)
EXPOSE 8000

# Default command uses run.sh (prod)
CMD ["./run.sh", "prod"]
